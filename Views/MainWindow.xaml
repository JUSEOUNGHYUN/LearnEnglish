<Window x:Class="Exam.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="영어 시험 프로그램" Height="450" Width="800"
        WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}"/>
    </Window.InputBindings>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <ComboBox Width="150" 
                      ItemsSource="{Binding SheetNames}"
                      SelectedItem="{Binding SelectedSheet}"
                      Margin="0,0,10,0"/>
            <Button Content="문제 불러오기" 
                    Command="{Binding LoadQuestionsCommand}"
                    Padding="10,5"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="{Binding CurrentQuestion.QuestionText}"
                       FontSize="18"
                       Margin="0,0,0,20"
                       TextWrapping="Wrap"/>

            <TextBlock Text="{Binding QuestionProgress}"
                       FontSize="14"
                       Margin="0,0,0,10"
                       HorizontalAlignment="Right"/>

            <StackPanel Grid.Row="1">
                <TextBlock Text="답을 입력하세요:"
                           FontSize="16"
                           Margin="0,0,0,5"/>
                <TextBox Text="{Binding UserAnswer, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="16"
                         Padding="5"
                         InputMethod.PreferredImeState="On"
                         Loaded="TextBox_Loaded"
                         GotFocus="TextBox_GotFocus"
                         Margin="0,0,0,10">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" 
                                  Command="{Binding CheckAnswerCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
            </StackPanel>

            <TextBlock Grid.Row="2"
                       Text="{Binding Message}"
                       FontSize="16"
                       Foreground="Red"
                       Margin="0,10,0,0"
                       Visibility="{Binding IsMessageVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <TextBlock Grid.Row="3"
                       Text="{Binding CorrectAnswerText}"
                       FontSize="16"
                       Foreground="Blue"
                       Margin="0,5,0,0"
                       Visibility="{Binding IsMessageVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="정답 확인" 
                    Command="{Binding CheckAnswerCommand}"
                    Margin="0,0,10,0"
                    Padding="10,5"/>
            <Button Content="다음 문제" 
                    Command="{Binding NextQuestionCommand}"
                    Padding="10,5"/>
            <TextBlock Text="{Binding Score, StringFormat='점수: {0}점'}"
                       VerticalAlignment="Center"
                       Margin="20,0,0,0"
                       FontSize="16"/>
        </StackPanel>
    </Grid>
</Window> 